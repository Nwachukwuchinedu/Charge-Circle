# ── Required ────────────────────────────────────────────────────────────────
# Backend will refuse to start without these.

# Neon Postgres — pooled URL (with ?pgbouncer=true for production)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Postgres — direct URL (for Prisma migrations, no pool)
DIRECT_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Upstash Redis — TCP endpoint with TLS (from Upstash dashboard → Redis Connect)
REDIS_URL=rediss://default:<token>@funky-filly-104222.upstash.io:6379

# ── Optional ────────────────────────────────────────────────────────────────

# JWT secret — defaults to a dev-only hardcoded value if unset
JWT_ACCESS_SECRET=your-random-64-char-secret-here

# Server port — defaults to 4000
PORT=4000

# Set to "production" to suppress debug logs and disable file logging
NODE_ENV=development
